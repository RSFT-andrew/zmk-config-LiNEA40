#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        MouseLayer {
            bindings = <&tog 2>;
            key-positions = <8 9>;
        };

        layer0 {
            bindings = <&tog 0>;
            key-positions = <16 17>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp W             &kp E                   &kp LEFT_PARENTHESIS  &kp I       &kp RIGHT_PARENTHESIS                                &kp F          &kp S  &kp Y                &kp H                  &kp P
&kp A             &kp U                   &kp X                 &kp C       &kp O                                                &kp R          &kp K  &kp T                &kp D                  &kp N
&kp Q             &mt AMPERSAND QUESTION  &kp J                 &kp V       &lt 4 COMMA                                          &lt 5 Z        &kp G  &kp B                &kp L                  &kp M
&lt 6 LANGUAGE_2  &kp LG(Z)               &kp LS(LG(Z))         &kp C_MUTE  &mt LEFT_SHIFT PERIOD  &kp SPACE    &lt 3 BACKSPACE  &kp BACKSPACE         &mt RIGHT_ALT MINUS  &mt RIGHT_CONTROL TAB  &mt RIGHT_COMMAND LANGUAGE_1
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        other {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        mouseNo,1 {
            bindings = <
&kp ESCAPE            &mt END HOME          &kp GLOBE      &kp C   &kp RG(INT_YEN)                      &mt RG(F3) F3    &mkp MB4      &mkp MB5       &mkp MB1        &mkp MB2
&kp LS(LG(NUMBER_2))  &kp LS(LG(NUMBER_1))  &kp LS(LG(X))  &trans  &kp RG(LEFT)                         &kp RS(RC(TAB))  &kp RC(TAB)   &mkp MB3       &msc SCRL_DOWN  &msc SCRL_UP
&kp LS(LG(V))         &kp LS(LG(NUMBER_4))  &kp LS(LG(F))  &trans  &trans                               &trans           &kp RC(LEFT)  &kp RC(RIGHT)  &msc SCRL_LEFT  &msc SCRL_RIGHT
&trans                &trans                &trans         &trans  &mkp MB2         &mkp MB1    &trans  &trans                         &trans         &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        mouseNo.2 {
            bindings = <
&kp ESCAPE            &mt END HOME          &kp GLOBE      &kp C            &kp LG(INT_YEN)                        &mt RG(F3) F3          &kp RS(LEFT)  &kp RS(UP)    &kp RS(RIGHT)  &kp RG(INT_YEN)
&kp LS(LG(NUMBER_2))  &kp LS(LG(NUMBER_1))  &kp LS(LG(X))  &kp LS(LC(TAB))  &kp LC(TAB)                            &kp RG(RIGHT_CONTROL)  &kp UP        &kp RS(DOWN)  &mkp MB3       &kp RG(LEFT)
&kp LS(LG(V))         &kp LS(LG(NUMBER_4))  &kp LS(LG(F))  &kp LC(LEFT)     &kp LC(RIGHT_ARROW)                    &kp LEFT               &kp DOWN      &kp RIGHT     &kp PAGE_DOWN  &kp PAGE_UP
&trans                &trans                &trans         &trans           &trans               &trans    &trans  &trans                               &trans        &trans         &trans
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        Number {
            bindings = <
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(N9)     &kp LS(NUMBER_5)  &kp LS(NUMBER_0)                    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL  &kp INT_YEN
&kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp KP_DIVIDE  &kp KP_ASTERISK   &kp LS(NUMBER_6)                    &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp COLON  &kp TILDE
&kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp PLUS       &kp MINUS         &trans                              &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0     &kp PERIOD
&trans            &trans            &kp LG(Y)      &trans            &trans            &trans    &trans  &kp DELETE                  &trans        &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_DEC C_BRIGHTNESS_INC>;
        };

        symbol {
            bindings = <
&kp ESCAPE         &kp LEFT_BRACE         &kp LEFT_BRACKET   &kp RIGHT_BRACE  &kp RIGHT_BRACKET                    &kp HOME    &kp END                  &kp RG(W)      &kp RS(RG(V))  &kp RS(RG(NUMBER_4))
&kp DOUBLE_QUOTES  &kp SEMICOLON          &kp BACKSLASH      &kp COLON        &kp CARET                            &trans      &mt RC(RS(TAB)) RC(TAB)  &kp RG(T)      &kp RG(L)      &kp RS(RG(F))
&kp SQT            &kp GRAVE              &kp EQUAL          &kp UNDERSCORE   &kp LESS_THAN                        &trans      &kp RC(LEFT)             &kp RC(RIGHT)  &kp RS(RC(L))  &kp RG(M)
&trans             &kp LG(RIGHT_BRACKET)  &kp RG(BACKSLASH)  &kp LC(LG(Q))    &kp GREATER_THAN   &trans    &trans  &kp DELETE                           &trans         &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        WIRELESS {
            bindings = <
&bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1    &bt BT_SEL 0                         &trans          &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans          &trans                               &trans          &trans  &trans  &trans  &trans
&trans        &trans        &trans        &bt BT_CLR_ALL  &bt BT_CLR                           &trans          &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans          &trans        &trans    &bootloader  &studio_unlock          &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
